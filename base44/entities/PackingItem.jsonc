{
  "name": "PackingItem",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "clothing",
        "shoes",
        "accessories",
        "toiletries",
        "electronics",
        "documents",
        "sports_gear",
        "nutrition",
        "other"
      ]
    },
    "quantity": {
      "type": "integer",
      "default": 1
    },
    "checked_bag_only": {
      "type": "boolean",
      "default": false
    },
    "is_sports": {
      "type": "boolean",
      "default": false
    },
    "packed": {
      "type": "boolean",
      "default": false
    },
    "note": {
      "type": "string"
    },
    "closet_item_id": {
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "name",
    "category",
    "quantity"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}