{
  "name": "UnpackFeedback",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "is_sports": {
      "type": "boolean",
      "default": false
    },
    "is_extra": {
      "type": "boolean",
      "default": false
    },
    "extra_reason": {
      "type": "string",
      "enum": [
        "forgot_to_pack",
        "bought_for_fun",
        "other"
      ],
      "default": "other"
    },
    "packed_quantity": {
      "type": "integer",
      "default": 0
    },
    "quantity_unused": {
      "type": "integer",
      "default": 0
    },
    "quantity_repeated": {
      "type": "integer",
      "default": 0
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "item_name",
    "category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}